@page "/trackbar"
<PageTitle>SLVZ UI | Trackbar</PageTitle>


<main>

    <h1 style="font-size:25px;" class="title">Trackbar</h1>
    <p class="description">Trackbar style</p>


    <div class="flex">
        <span>Value: @Value</span>
    </div>
    
    <div class="slvz-trackbar">

        <div class="track"></div>
        <div class="fill" style="width:@FillWidth;"></div>

        <input type="range" min="@Min" max="@Max" step="@Steps" @bind="Value" @oninput="OnInput" />

    </div>
    
    <div class="flex">

        <span>Min</span>
        <div class="slvz-textbox"><input @bind="Min" type="number" maxlength="4" /></div>

        <span>Max</span>
        <div class="slvz-textbox"><input @bind="Max" type="number" maxlength="4" /></div>

        <span>Steps</span>
        <div class="slvz-textbox"><input @bind="Steps" type="number" maxlength="2" /></div>

    </div>

    <CodeBlock Language="razor" Code="@trackBar" />

</main>