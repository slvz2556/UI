@page "/buttons"
<PageTitle>SLVZ UI | Buttons</PageTitle>


<main>

    <h1 style="font-size:25px;" class="title">Buttons</h1>
    <p class="description">All buttons with different styles</p>


    <h1 style="font-size:25px; margin-top:40px; " class="title">Primary button</h1>
    <button class="btn slvz-button primary">Primary</button>
    
    <div class="codeblock">
        <div class="head">
            <span>razor</span>
            <button class="copy-btn" onclick="CopyCode(this)"><span class="copy-label">Copy</span></button>
        </div>
        <pre>
            <code class="language-razor">
@("<button class=\"slvz-button primary\">Click me</button>")
            </code>
        </pre>
    </div>


    <h1 style="font-size:25px; margin-top:40px;" class="title">Pale button</h1>
    <button class="btn slvz-button pale">Pale</button>

    <div class="codeblock">
        <div class="head">
            <span>razor</span>
            <button class="copy-btn" onclick="CopyCode(this)"><span class="copy-label">Copy</span></button>
        </div>
        <pre>
            <code class="language-razor">
@("<button class=\"slvz-button pale\">Click me</button>")
            </code>
        </pre>
    </div>


    <h1 style="font-size:25px; margin-top:40px;" class="title">Default button</h1>
    <button class="btn slvz-button default">Default</button>

    <div class="codeblock">
        <div class="head">
            <span>razor</span>
            <button class="copy-btn" onclick="CopyCode(this)"><span class="copy-label">Copy</span></button>
        </div>
        <pre>
            <code class="language-razor">
@("<button class=\"slvz-button default\">Click me</button>")
            </code>
        </pre>
    </div>


    <h1 style="font-size:25px; margin-top:40px; " class="title">Button with icon</h1>
    <button class="btn slvz-button primary">
        <svg viewBox="0 0 20 20">
            <path d="M9.38843 4.28963C7.69278 2.57693 4.94954 2.5686 3.26122 4.2739C1.5729 5.9792 1.58114 8.75004 3.27679 10.4627L9.55368 16.8028C9.81404 17.0657 10.2362 17.0657 10.4965 16.8028L16.7408 10.4994C18.4252 8.78856 18.4199 6.02549 16.7239 4.31249C15.0252 2.59671 12.2807 2.58838 10.5894 4.29673L9.99299 4.90026L9.38843 4.28963Z" />
        </svg>
        Click me
    </button>

    <div class="codeblock">
        <div class="head">
            <span>razor</span>
            <button class="copy-btn" onclick="CopyCode(this)"><span class="copy-label">Copy</span></button>
        </div>
        <pre>
            <code class="language-razor">
@("<button class=\"slvz-button primary slvz-icon\">")
    @("<img src='https://ui.slvz.dev/icons/Heart/ic_fluent_heart_20_filled.svg'/>") 
    @("Click me")
@("</button>")
            </code>
        </pre>
    </div>


</main>