@page "/menu"
<PageTitle>SLVZ UI | Menu</PageTitle>


<main>

    <h1 style="font-size:25px;" class="title">Drop-Down list</h1>

    <div class="slvz-drop-down">
        <div class="slvz-drop-down-body slvz-button default" onclick="OpenDropList(this)">
            <span>
                @selectedItem.ToString()
            </span>
            <svg class="slvz-arrow" viewBox="0 0 24 24">
                <path d="M19.7036 12L11.2125 3.27302C10.9236 2.97614 10.9301 2.50131 11.227 2.21246C11.5239 1.9236 11.9987 1.93011 12.2875 2.22698L21.2875 11.477C21.5708 11.7681 21.5708 12.2319 21.2875 12.523L12.2875 21.773C11.9987 22.0699 11.5239 22.0764 11.227 21.7875C10.9301 21.4987 10.9236 21.0239 11.2125 20.727L19.7036 12Z" />
            </svg>
        </div>

        <div class="slvz-drop-down-list drop-hide">
            <button class='slvz-button @(selectedItem==Items.Item1 ? "pale" : "default")' @onclick='() => ChangeItems(Items.Item1)'>
                @Items.Item1.ToString()
            </button>
            <button class='slvz-button @(selectedItem == Items.Item2 ? "pale" : "default")' @onclick='() => ChangeItems(Items.Item2)'>
                @Items.Item2.ToString()
            </button>
            <button class='slvz-button @(selectedItem == Items.Item3 ? "pale" : "default")' @onclick='() => ChangeItems(Items.Item3)'>
                @Items.Item3.ToString()
            </button>
        </div>

    </div>
    <CodeBlock Language="razor" Code="@dropDown" />




    <h1 style="font-size:25px; margin-top:50px;" class="title">Overflow menu</h1>

    <div class="slvz-overflow-menu">
        <div class="slvz-overflow-menu-button slvz-button default" onclick="OpenDropList(this)">
            <svg viewBox="0 0 20 20">
                <path d="M6.25 10C6.25 10.6904 5.69036 11.25 5 11.25C4.30964 11.25 3.75 10.6904 3.75 10C3.75 9.30964 4.30964 8.75 5 8.75C5.69036 8.75 6.25 9.30964 6.25 10ZM11.25 10C11.25 10.6904 10.6904 11.25 10 11.25C9.30964 11.25 8.75 10.6904 8.75 10C8.75 9.30964 9.30964 8.75 10 8.75C10.6904 8.75 11.25 9.30964 11.25 10ZM15 11.25C15.6904 11.25 16.25 10.6904 16.25 10C16.25 9.30964 15.6904 8.75 15 8.75C14.3096 8.75 13.75 9.30964 13.75 10C13.75 10.6904 14.3096 11.25 15 11.25Z" />
            </svg>
        </div>

        <div class="slvz-overflow-menu-list drop-hide">
            <button class='slvz-button default' @onclick='() => ChangeItems(Items.Item1)'>
                @Items.Item1.ToString()
            </button>
            <button class='slvz-button default' @onclick='() => ChangeItems(Items.Item2)'>
                @Items.Item2.ToString()
            </button>
            <button class='slvz-button default' @onclick='() => ChangeItems(Items.Item3)'>
                @Items.Item3.ToString()
            </button>
        </div>

    </div>

    <CodeBlock Language="razor" Code="@overflowList" />
    







</main>


