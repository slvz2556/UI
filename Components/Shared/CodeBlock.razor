<div class="codeblock">
    <div class="head">
        <span>@Language</span>
        <button class="copy-btn" onclick="CopyCode(this)"><span class="copy-label">Copy</span></button>
    </div>
    <pre>
        <code class="language-@Language">
@Code
        </code>
    </pre>
</div>


@code
{
    [Parameter] public string Language { get; set; } = "csharp";
    [Parameter] public string Code { get; set; } = string.Empty;
}

