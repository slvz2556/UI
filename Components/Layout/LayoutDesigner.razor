@page "/layout-designer"

<PageTitle>SLVZ UI | Layout designer</PageTitle>


<div class="topbar">

    <button class="btn-add slvz-button primary" id="addBtn">
        <svg viewBox="0 0 20 20">
            <path d="M10 2.5C10.2761 2.5 10.5 2.72386 10.5 3V9.5H17C17.2761 9.5 17.5 9.72386 17.5 10C17.5 10.2761 17.2761 10.5 17 10.5H10.5V17C10.5 17.2761 10.2761 17.5 10 17.5C9.72386 17.5 9.5 17.2761 9.5 17V10.5H3C2.72386 10.5 2.5 10.2761 2.5 10C2.5 9.72386 2.72386 9.5 3 9.5H9.5V3C9.5 2.72386 9.72386 2.5 10 2.5Z" />
        </svg>
        <span>Add section</span>
    </button>

    <span class="counter" id="counter">0 / 10</span>

    <div class="device-switch" id="deviceSwitch">
        <button class="slvz-button primary" data-device="desktop" title="Desktop">
            <svg viewBox="0 0 20 20">
                <path d="M4 2C2.89543 2 2 2.89543 2 4V13C2 14.1046 2.89543 15 4 15H7V17H5.5C5.22386 17 5 17.2239 5 17.5C5 17.7761 5.22386 18 5.5 18H14.5C14.7761 18 15 17.7761 15 17.5C15 17.2239 14.7761 17 14.5 17H13V15H16C17.1046 15 18 14.1046 18 13V4C18 2.89543 17.1046 2 16 2H4ZM12 15V17H8V15H12ZM3 4C3 3.44772 3.44772 3 4 3H16C16.5523 3 17 3.44772 17 4V13C17 13.5523 16.5523 14 16 14H4C3.44772 14 3 13.5523 3 13V4Z" />
            </svg>
        </button>
        <button class="slvz-button" data-device="tablet" title="Tablet">
            <svg viewBox="0 0 20 20">
                <path d="M8.5 12C8.22386 12 8 12.2239 8 12.5C8 12.7761 8.22386 13 8.5 13H11.5C11.7761 13 12 12.7761 12 12.5C12 12.2239 11.7761 12 11.5 12H8.5ZM4 4C2.89543 4 2 4.89543 2 6V14C2 15.1046 2.89543 16 4 16H16C17.1046 16 18 15.1046 18 14V6C18 4.89543 17.1046 4 16 4H4ZM3 6C3 5.44772 3.44772 5 4 5H16C16.5523 5 17 5.44772 17 6V14C17 14.5523 16.5523 15 16 15H4C3.44772 15 3 14.5523 3 14V6Z" />
            </svg>
        </button>
        <button class="slvz-button" data-device="mobile" title="Mobile">
            <svg viewBox="0 0 20 20">
                <path d="M9 14C8.72386 14 8.5 14.2239 8.5 14.5C8.5 14.7761 8.72386 15 9 15H11C11.2761 15 11.5 14.7761 11.5 14.5C11.5 14.2239 11.2761 14 11 14H9ZM7 2C5.89543 2 5 2.89543 5 4V16C5 17.1046 5.89543 18 7 18H13C14.1046 18 15 17.1046 15 16V4C15 2.89543 14.1046 2 13 2H7ZM6 4C6 3.44772 6.44772 3 7 3H13C13.5523 3 14 3.44772 14 4V16C14 16.5523 13.5523 17 13 17H7C6.44772 17 6 16.5523 6 16V4Z" />
            </svg>
        </button>
    </div>

    <button class="btn-reset slvz-button default" id="resetBtn">
        <svg viewBox="0 0 20 20">
            <path d="M5.85355 2.64645C6.04882 2.84171 6.04882 3.15829 5.85355 3.35355L4.20711 5H11C14.3137 5 17 7.68629 17 11C17 14.3137 14.3137 17 11 17C7.68629 17 5 14.3137 5 11C5 10.7239 5.22386 10.5 5.5 10.5C5.77614 10.5 6 10.7239 6 11C6 13.7614 8.23858 16 11 16C13.7614 16 16 13.7614 16 11C16 8.23858 13.7614 6 11 6H4.20711L5.85355 7.64645C6.04882 7.84171 6.04882 8.15829 5.85355 8.35355C5.65829 8.54882 5.34171 8.54882 5.14645 8.35355L2.64645 5.85355C2.45118 5.65829 2.45118 5.34171 2.64645 5.14645L5.14645 2.64645C5.34171 2.45118 5.65829 2.45118 5.85355 2.64645Z" />
        </svg>
        <span>Reset</span>
    </button>

</div>

<main>
    <div class="canvas-wrap">
        <div class="device-frame" id="deviceFrame" data-device="desktop">
            <div class="slvz-grid" id="slvzGrid"></div>
        </div>
        <div class="hidden-tray" id="hiddenTray" hidden></div>
    </div>

    <div class="code-panel">
        <div class="tabs">
            <button class="slvz-button primary" data-tab="html">HTML</button>
            <button class="slvz-button" data-tab="css">CSS</button>
        </div>
        <div class="codeblock">
            <div class="head">
                <span id="codeLangLabel">html</span>
                <button class="copy-btn" id="copyBtn"><span class="copy-label">Copy</span></button>
            </div>
            <pre>
                <code id="codeOutput"></code>
            </pre>
        </div>
    </div>
</main>