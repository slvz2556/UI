@page "/"

<PageTitle>SLVZ UI</PageTitle>


<main>

    <h1 style="font-size:25px;" class="title">SLVZ UI</h1>
    <p class="description">
        A soft, modern UI component library for Blazor.<br />
        Themeable with a single color, light and dark ready, and built to be copy-pasted.
    </p>


    <div class="stats">
        <div class="stat slvz-card default"><b>2965</b><span>Fluent icons</span></div>
        <div class="stat slvz-card default"><b>5</b><span>Components</span></div>
        <div class="stat slvz-card default"><b>Light / Dark</b><span>Themes</span></div>
        <div class="stat slvz-card default"><b>1 color</b><span>To generate a theme</span></div>
    </div>


    @* ───────── Tools ───────── *@
    <h2 style="font-size:25px;" class="title">Tools</h2>
    <p class="description">
        Small tools that live next to the components and make building UIs faster.
    </p>
    <div class="block grid">
        <a class="tile slvz-card default" href="fluent-icons">
            <h3>Fluent icons</h3>
            <p>Search and copy from the full Fluent icon set.</p>
            <span class="go">Open →</span>
        </a>
        <a class="tile slvz-card default" href="layout-designer">
            <h3>Layout designer</h3>
            <p>Drag and resize sections on a grid for desktop, tablet and mobile, then export clean HTML/CSS.</p>
            <span class="go">Open →</span>
        </a>
        <a class="tile slvz-card default" href="timeline-studio">
            <h3>Timeline studio</h3>
            <p>Animate elements on a canvas and control them with a timeline.</p>
            <span class="go">Open →</span>
        </a>
        <a class="tile slvz-card default" href="colors">
            <h3>Colors</h3>
            <p>Pick any color or a ready-made template and get a full light/dark theme as CSS variables.</p>
            <span class="go">Open →</span>
        </a>
    </div>




    @* ───────── Quick start ───────── *@
    <h2 style="font-size:25px;" class="title">Quick start</h2>
    <p class="description">
        Three steps and you are done.
    </p>

    @* ───────── Codebloxk ───────── *@
    <UI.Components.Shared.CodeBlock Language="html" Code="@setup" />



    @* ───────── Footer ───────── *@
    <footer class="foot">
        <span>Made by SLVZ</span>
        <a href="https://slvz.dev" target="_blank" rel="noopener">slvz.dev</a>
    </footer>

</main>


@code {
    private const string setup = 
"""
<link rel="stylesheet" href="slvz.style.main.css" />
<link rel="stylesheet" href="slvz.colors.css" />
<script src="slvz.script.main.js"></script>
""";
}