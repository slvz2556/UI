@page "/"

<PageTitle>SLVZ UI</PageTitle>


<main>

    <h1 style="font-size:25px;" class="title">SLVZ UI</h1>
    <p class="description">Change components color to see how they look</p>

    <!-- Example 1: C# -->
    <div class="codeblock">
        <div class="head">
            <span>csharp</span>
            <button class="copy-btn" onclick="CopyCode(this)"><span class="copy-label">Copy</span></button>
        </div>
        <pre>
            <code class="language-csharp">
public class main
{
    int main() => 
        Console.WriteLine("Hello world!");
}
            </code>
        </pre>
    </div>

</main>