@page "/"

<PageTitle>SLVZ UI</PageTitle>


<main>

    <h1 style="font-size:25px;" class="title">SLVZ UI</h1>
    <p class="description">
        A soft, modern UI component library for Blazor.<br/>
        Themeable with a single color, light and dark ready, and built to be copy-pasted.
    </p>
    

    <div class="stats">
        <div class="stat"><b>2965</b><span>Fluent icons</span></div>
        <div class="stat"><b>5</b><span>Components</span></div>
        <div class="stat"><b>Light / Dark</b><span>Themes</span></div>
        <div class="stat"><b>1 color</b><span>To generate a theme</span></div>
    </div>


    @* ───────── Tools ───────── *@
    <section class="block">
        <h2>Tools</h2>
        <p class="sub">Small tools that live next to the components and make building UIs faster.</p>

        <div class="grid">
            <a class="tile" href="fluent-icons">
                <h3>Fluent icons</h3>
                <p>Search and copy from the full Fluent icon set.</p>
                <span class="go">Open →</span>
            </a>
            <a class="tile" href="layout-designer">
                <h3>Layout designer</h3>
                <p>Drag and resize sections on a grid for desktop, tablet and mobile, then export clean HTML/CSS.</p>
                <span class="go">Open →</span>
            </a>
            <a class="tile" href="timeline-studio">
                <h3>Timeline studio</h3>
                <p>Animate elements on a canvas and control them with a timeline.</p>
                <span class="go">Open →</span>
            </a>
            <a class="tile" href="colors">
                <h3>Colors</h3>
                <p>Pick any color or a ready-made template and get a full light/dark theme as CSS variables.</p>
                <span class="go">Open →</span>
            </a>
        </div>
    </section>




    <!-- Example 1: C# -->
    <div class="codeblock">
        <div class="head">
            <span>csharp</span>
            <button class="copy-btn" onclick="CopyCode(this)"><span class="copy-label">Copy</span></button>
        </div>
        <pre>
            <code class="language-csharp">
public class main
{
    int main() => 
        Console.WriteLine("Hello world!");
}
            </code>
        </pre>
    </div>

</main>