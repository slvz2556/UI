@page "/timeline"
<PageTitle>SLVZ UI | Timeline studio</PageTitle>

<main class="slvz-timeline-studio">

    <header id="topbar" class="slvz-card default">

        <button class="slvz-button primary" id="addBtn">+ Add Element</button>

        <div class="sep"></div>

        <button class="slvz-button default icon paused" id="playBtn" title="Play/Pause">
            <svg class="ic-play" viewBox="0 0 20 20">
                <path d="M17.2221 8.68458C18.2586 9.25438 18.2586 10.7437 17.2221 11.3135L7.22259 16.8105C6.22292 17.36 5 16.6367 5 15.496L5 4.50214C5 3.36137 6.22292 2.63812 7.22259 3.18766L17.2221 8.68458Z" />
            </svg>
            <svg class="ic-pause" viewBox="0 0 20 20">
                <path d="M5 2C3.89543 2 3 2.89543 3 4V16C3 17.1046 3.89543 18 5 18H7C8.10457 18 9 17.1046 9 16V4C9 2.89543 8.10457 2 7 2H5ZM13 2C11.8954 2 11 2.89543 11 4V16C11 17.1046 11.8954 18 13 18H15C16.1046 18 17 17.1046 17 16V4C17 2.89543 16.1046 2 15 2H13Z" />
            </svg>
        </button>

        <span id="timeLabel">0 / 5000ms</span>

        <div class="sep"></div>

        <div id="durationField">

            Timeline length

            <input class="slvz-textbox" type="number" id="durationInput" value="5000" step="500" min="500">

            ms

        </div>

        <div class="sep"></div>

        <div id="stageField">

            Canvas size

            <input class="slvz-textbox" type="number" id="stageW" min="10" max="1500">

            ×

            <input class="slvz-textbox" type="number" id="stageH" min="10" max="1500">

            px

        </div>

        <div class="sep"></div>

        <div id="zoomField">

            Zoom

            <button class="slvz-button default mini" id="zoomOutBtn">
                <svg viewBox="0 0 20 20">
                    <path d="M3 10C3 9.72386 3.22386 9.5 3.5 9.5H16.5C16.7761 9.5 17 9.72386 17 10C17 10.2761 16.7761 10.5 16.5 10.5H3.5C3.22386 10.5 3 10.2761 3 10Z" />
                </svg>
            </button>

            <span id="zoomLabel">100%</span>

            <button class="slvz-button default mini" id="zoomInBtn">
                <svg viewBox="0 0 20 20">
                    <path d="M10 2.5C10.2761 2.5 10.5 2.72386 10.5 3V9.5H17C17.2761 9.5 17.5 9.72386 17.5 10C17.5 10.2761 17.2761 10.5 17 10.5H10.5V17C10.5 17.2761 10.2761 17.5 10 17.5C9.72386 17.5 9.5 17.2761 9.5 17V10.5H3C2.72386 10.5 2.5 10.2761 2.5 10C2.5 9.72386 2.72386 9.5 3 9.5H9.5V3C9.5 2.72386 9.72386 2.5 10 2.5Z" />
                </svg>
            </button>

            <button class="slvz-button pale" id="zoomResetBtn" style="padding:0 10px;">Reset</button>

        </div>

        <div class="spacer"></div>

        <button class="slvz-button default" @onclick="ExportCode" id="exportBtn">Export</button>

    </header>


    <div id="stageRow">

        <aside id="rightPanel" class="slvz-card default">

            <h2>Elements</h2>

            <div id="elList"></div>

            <div id="addTrackBox">

                <div id="trackSelect" data-dir="up"></div>

                <button class="slvz-button pale" id="addTrackBtn">+ Add animated property</button>

            </div>

        </aside>

        <div id="canvasWrap">

            <div id="canvas"><div id="guides"></div></div>

            <div id="inspector" class="slvz-card default">

                <h3>Keyframe</h3>

                <div class="row"><label>Time</label><input class="slvz-textbox" type="number" id="kfTime" step="10"></div>

                <div class="row"><label>Value</label><input class="slvz-textbox" type="number" id="kfValueNum" step="1"></div>

                <div class="row" id="kfColorRow" style="display:none;"><label>Value</label><input type="color" id="kfValueColor"></div>

                <div class="row">

                    <label>Easing</label>

                    <div id="kfEasing" data-dir="up"></div>

                </div>

                <div class="row" id="kfBezierRow" style="display:none;">

                    <label>Bezier</label>

                    <input class="slvz-textbox" type="number" id="bz1" step="0.05" style="width:40px" placeholder="x1">

                    <input class="slvz-textbox" type="number" id="bz2" step="0.05" style="width:40px" placeholder="y1">

                    <input class="slvz-textbox" type="number" id="bz3" step="0.05" style="width:40px" placeholder="x2">

                    <input class="slvz-textbox" type="number" id="bz4" step="0.05" style="width:40px" placeholder="y2">

                </div>

                <button class="slvz-button default" id="deleteKfBtn">Delete Keyframe</button>

            </div>

        </div>

    </div>


    <section id="timelineWrap" class="slvz-card default">

        <div id="timelineHead">

            <span class="hint">Drag an element to move it, top handle to rotate, bottom handle to scale, corner handle to resize — hold Shift to snap (10px / 5°), hold Alt while dragging a keyframe to duplicate it</span>

        </div>

        <div id="timelineBody">

            <div id="trackLabels"></div>

            <div id="tracksScroll">

                <div id="timelineScrollInner">

                    <div id="playheadHead"><i></i></div>

                    <div id="ruler"></div>

                    <div id="tracksArea"></div>

                    <div id="playhead"></div>

                </div>

            </div>

        </div>

    </section>

</main>





