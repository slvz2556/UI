@page "/cards"
<PageTitle>SLVZ UI | Cards</PageTitle>


<main>

    <h1 style="font-size:25px;" class="title">Cards</h1>
    <p class="description">All cards with different styles</p>






    <h1 style="font-size:25px; margin-top:40px;" class="title">Default card</h1>
    <div class="card slvz-card default">Default</div>

    <div class="codeblock">
        <div class="head">
            <span>html</span>
            <button class="copy-btn" onclick="CopyCode(this)"><span class="copy-label">Copy</span></button>
        </div>
        <pre>
            <code class="language-html">
@("<div class=\"slvz-card default\"></div>")
            </code>
        </pre>
    </div>


    <h1 style="font-size:25px; margin-top:40px;" class="title">Default pale</h1>
    <div class="card slvz-card pale">Pale</div>

    <div class="codeblock">
        <div class="head">
            <span>html</span>
            <button class="copy-btn" onclick="CopyCode(this)"><span class="copy-label">Copy</span></button>
        </div>
        <pre>
            <code class="language-html">
@("<div class=\"slvz-card pale\"></div>")
            </code>
        </pre>
    </div>


</main>