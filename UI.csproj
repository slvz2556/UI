<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ApplicationIcon>wwwroot\favicon.ico</ApplicationIcon>
    <Title>Fluent Icons</Title>
    <Authors>Ashkan SLVZ</Authors>
    <Company>SLVZ</Company>
    <Product>Fluent Icons</Product>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
  </ItemGroup>


    <Target Name="RemovePdbFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
	    <ItemGroup>
		    <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
	    </ItemGroup>
    </Target>

</Project>
